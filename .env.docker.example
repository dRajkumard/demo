# Copy to .env.docker in the repo root, then fill in real values:
#   cp .env.docker.example .env.docker
#
# Compose overrides DATABASE_URL / Redis / Kafka / service URLs for containers.
# These keys are what the apps still read from the env file.

# ── Supabase (required for gateway auth) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# SRM uses slightly different names for the same project
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1

# ── AI Proxy ─────────────────────────────────────────────────
# Required at process start even if you mainly use Ollama
MISTRAL_API_KEY=
MISTRAL_ONLY=true
GROQ_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shared secret for service-to-service calls; read by ai-proxy config/settings.py.
# Defaults to empty if unset, which disables the internal-caller check.
INTERNAL_API_KEY=

# Host Ollama (install from https://ollama.com then: ollama serve && ollama pull qwen3:4b)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_DEFAULT=true
OLLAMA_FOR_CODING=false

# ── Browser / CORS ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_GATEWAY_BACKEND_URL=http://localhost:3001

# Encrypts the API keys organisations bring for their own AI providers
# (AES-256-GCM). Generated by the installer. Changing it makes every stored
# provider key undecryptable, which surfaces as a failed connection test.
PROVIDER_ENCRYPTION_KEY=

# Password for the unprivileged database role the tenant path connects as.
# Row-level security is only enforced because the services use this role rather
# than the owner. Generated by the installer.
APP_DB_PASSWORD=

# Who may administer the whole platform, comma-separated. Granted here and
# nowhere else: no database write can confer it.
PLATFORM_ADMIN_EMAILS=

# Where the web app is reachable. Invitation links point here.
PUBLIC_APP_URL=http://localhost:8080
